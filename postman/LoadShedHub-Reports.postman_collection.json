{
  "info": {"name": "LoadShed Hub - 12 API Tests", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"token","value":""},
    {"key":"locationId","value":"1"},
    {"key":"reportId","value":"1"}
  ],
  "item": [
    {"name":"01 Register citizen", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"firstName\":\"Test\",\"lastName\":\"Citizen\",\"email\":\"test.citizen@example.com\",\"password\":\"Password123\"}"},"url":"{{baseUrl}}/api/auth/register"}},
    {"name":"02 Register duplicate email (400)", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"test.citizen@example.com\",\"password\":\"Password123\"}"},"url":"{{baseUrl}}/api/auth/register"}},
    {"name":"03 Register invalid email (400)", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"not-an-email\",\"password\":\"Password123\"}"},"url":"{{baseUrl}}/api/auth/register"}},
    {"name":"04 Login and save token", "event":[{"listen":"test","script":{"exec":["var body = pm.response.json();", "pm.collectionVariables.set('token', body.data.token);"]}}], "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"test.citizen@example.com\",\"password\":\"Password123\"}"},"url":"{{baseUrl}}/api/auth/login"}},
    {"name":"05 Login invalid password (400)", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"test.citizen@example.com\",\"password\":\"WrongPassword123\"}"},"url":"{{baseUrl}}/api/auth/login"}},
    {"name":"06 Create report", "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"locationId\":{{locationId}},\"powerStatus\":\"ON\",\"wifiStatus\":\"AVAILABLE\",\"crowdLevel\":\"LOW\",\"safetyRating\":\"SAFE\",\"comment\":\"Power is on.\"}"},"url":"{{baseUrl}}/api/reports"}},
    {"name":"07 Create invalid report (400)", "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"locationId\":{{locationId}},\"powerStatus\":\"\"}"},"url":"{{baseUrl}}/api/reports"}},
    {"name":"08 Create report for missing location (404)", "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"locationId\":999999,\"powerStatus\":\"ON\"}"},"url":"{{baseUrl}}/api/reports"}},
    {"name":"09 List location reports", "request":{"method":"GET","url":"{{baseUrl}}/api/reports/location/{{locationId}}"}},
    {"name":"10 List recent location reports", "request":{"method":"GET","url":"{{baseUrl}}/api/reports/location/{{locationId}}/recent"}},
    {"name":"11 List my reports", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/reports/mine"}},
    {"name":"12 Update my report", "request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"locationId\":{{locationId}},\"powerStatus\":\"OFF\",\"comment\":\"Power has gone off.\"}"},"url":"{{baseUrl}}/api/reports/{{reportId}}"}}
  ]
}
